{
  "rewrites": [
    {
      "source": "/mandi/:path*",
      "destination": "https://beejrakshak.onrender.com/mandi/:path*"
    },
    {
      "source": "/disease-api/:path*",
      "destination": "https://beejrakshak.onrender.com/disease/:path*"
    },
    {
      "source": "/disease/:path*",
      "destination": "https://beejrakshak.onrender.com/disease/:path*"
    },
    {
      "source": "/yield-api/:path*",
      "destination": "https://beejrakshak.onrender.com/yield/:path*"
    },
    {
      "source": "/schemes/:path*",
      "destination": "https://beejrakshak.onrender.com/schemes/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
