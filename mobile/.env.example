# Expo / React Native — copy to .env in this folder
# Same Supabase project as web; use EXPO_PUBLIC_ prefix for bundled values.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional — unified AIML origin (disease, mandi, fertilizer, schemes)
# EXPO_PUBLIC_API_ORIGIN=http://localhost:8001
# On a physical phone, use your PC LAN IP instead of localhost, e.g.
# EXPO_PUBLIC_API_ORIGIN=http://192.168.1.10:8001
# EXPO_PUBLIC_MANDI_API_BASE=http://localhost:8001/mandi
